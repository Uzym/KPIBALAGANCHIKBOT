# === Платформы ===
# Токен сообщества ВК (Настройки → Работа с API → Ключи доступа)
VK_TOKEN=
# ID сообщества ВК (частное — в нём проверяется членство; руководители — админы бота)
VK_GROUP_ID=
# Версия API ВК
VK_API_VERSION=5.199
# Токен бота от @BotFather
TG_TOKEN=

# === Хранение ===
DB_PATH=data/kpibalaganchikbot.db
TZ=Europe/Moscow

# === Люди ===
# Дополнительные админы (user_id ВК через запятую). Основные админы —
# руководители сообщества (берутся из API, обновление раз в час)
# ADMIN_VK_IDS=
# Тех-уведомления (запуск/перезапуск бота) — только этому id
# TECH_ADMIN_VK_ID=

# === Поведение ===
# Точки напоминаний, часов до начала события (для опросов — до закрытия)
REMINDER_HOURS=24,2
# Авто-закрытие записи: at_start — в момент начала; before_start — за N минут до
AUTOCLOSE_MODE=at_start
AUTOCLOSE_MINUTES=120
# true — не использовать юникод-зачёркивание в ВК (текстовая пометка вместо него)
VK_STRIKE_FALLBACK=false
# Максимум вариантов в опросе
POLL_MAX_OPTIONS=10
# Срок жизни уведомлений об объявлениях/изменениях в ЛС, часов
ANNOUNCE_NOTICE_TTL_HOURS=48
# Архив в сообщество: завершённые события/опросы и объявления постом на стену — true/false
VK_WALL_LOG=true

# === Сеть ===
# При ошибке CERTIFICATE_VERIFY_FAILED (антивирус/прокси подменяет HTTPS):
# путь к PEM-файлу с корневым сертификатом (напр., экспортированным из антивируса)…
# SSL_CA_BUNDLE=
# …или временно отключить проверку сертификатов (небезопасно, для диагностики)
# SSL_VERIFY=false
